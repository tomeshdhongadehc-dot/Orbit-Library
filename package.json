{
  "name": "orbit-library",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "prebuild": "node tools/build-library.mjs",
    "check:css": "node tools/check-css.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "node tools/check-css.mjs && node tools/scan-secrets.mjs && next build && pnpm typecheck && pnpm lint && vitest run",
    "scan:secrets": "node tools/scan-secrets.mjs",
    "audit:deps": "pnpm audit --prod --audit-level=moderate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.79.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "shadcn": "^4.23.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "packageManager": "pnpm@11.8.0"
}
